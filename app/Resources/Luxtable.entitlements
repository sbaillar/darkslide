<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened Runtime entitlements for every build scripts/build-app.sh signs (Developer ID,
       the local "Luxtable Dev" identity, or ad hoc). The app is deliberately not sandboxed:
       it spawns rsync, hdiutil and diskutil and reads and writes folders the user picks, so
       there is no com.apple.security.app-sandbox. Under the Hardened Runtime only the
       following is needed. Dev and ad-hoc builds run with it; untested with a real Developer
       ID signature (needs the owner's Apple account): if a Hardened Runtime build crashes at
       launch or the voice feature goes quiet, check here first. -->

  <!-- Voice commands record from the microphone (NSMicrophoneUsageDescription). Without this
       the Hardened Runtime silently delivers silence. -->
  <key>com.apple.security.device.audio-input</key><true/>

  <!-- Deliberately absent: cs.allow-jit and cs.allow-unsigned-executable-memory (Core ML and
       Metal compile shaders through system services, not in-process JIT),
       cs.disable-library-validation (nothing is dlopen'd; all code is in the signed bundle),
       network client/server and file-access entitlements (these only apply to sandboxed apps). -->
</dict>
</plist>
